{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrainTumorSegmentationDescriptor",
  "description": "Structured intermediate representation produced by TumorDescriptorGenerator (src/json_generation/descriptor_generator.py) from MoME+ segmentation output and Harvard-Oxford atlas mapping. Validated at runtime by schema_validator.py before report generation.",
  "type": "object",
  "required": [
    "patient_info",
    "imaging_metadata",
    "segmentation_results",
    "anatomical_mapping",
    "model_metadata"
  ],
  "properties": {

    "patient_info": {
      "type": "object",
      "description": "Built by TumorDescriptorGenerator._build_patient_info(). Only case_id is required; age, sex, scan_date are populated when patient_metadata dict is supplied.",
      "required": ["case_id"],
      "properties": {
        "case_id":   { "type": "string",  "description": "Unique patient identifier (anonymized)." },
        "age":       { "type": "integer", "description": "Patient age in years (optional)." },
        "sex":       { "type": "string",  "enum": ["M", "F", "Unknown"] },
        "scan_date": { "type": "string",  "format": "date", "description": "MRI acquisition date (YYYY-MM-DD)." }
      }
    },

    "imaging_metadata": {
      "type": "object",
      "description": "Built by TumorDescriptorGenerator._build_imaging_metadata(). Resolution extracted from NIfTI header zooms.",
      "required": ["modalities", "scanner_info"],
      "properties": {
        "modalities": {
          "type": "array",
          "description": "MRI sequences used. Defaults to ['T1','T1ce','T2','FLAIR'] if not overridden.",
          "items": { "type": "string", "enum": ["T1", "T1ce", "T2", "FLAIR"] }
        },
        "scanner_info": {
          "type": "object",
          "properties": {
            "manufacturer":   { "type": "string",  "description": "Scanner manufacturer ('Unknown' when not available from header)." },
            "field_strength": { "type": "number",  "description": "Tesla (default 3.0)." },
            "resolution_mm":  {
              "type": "array",
              "items": { "type": "number" },
              "description": "Voxel spacing [x, y, z] extracted via seg_img.header.get_zooms()."
            }
          }
        }
      }
    },

    "segmentation_results": {
      "type": "object",
      "description": "Built by TumorDescriptorGenerator._extract_segmentation_results(). Uses BraTS label convention: 1=necrotic core, 2=peritumoral edema, 4=enhancing tumor. Whole Tumor = labels {1,2,4}. Tumor Core = labels {1,4}.",
      "required": ["tumor_components", "volumetric_analysis"],
      "properties": {

        "tumor_components": {
          "type": "object",
          "description": "Per-label analysis produced by _analyze_component(seg_data, label, voxel_vol).",
          "properties": {
            "enhancing_tumor":  { "$ref": "#/definitions/tumor_component" },
            "necrotic_core":    { "$ref": "#/definitions/tumor_component" },
            "peritumoral_edema":{ "$ref": "#/definitions/tumor_component" }
          }
        },

        "volumetric_analysis": {
          "type": "object",
          "required": ["total_tumor_volume_mm3"],
          "description": "Aggregate volumes computed directly from voxel counts × voxel_vol (mm³).",
          "properties": {
            "total_tumor_volume_mm3":   { "type": "number", "description": "Whole Tumor volume (labels > 0)." },
            "whole_tumor_volume_mm3":   { "type": "number" },
            "tumor_core_volume_mm3":    { "type": "number", "description": "Labels {1, 4}." },
            "enhancing_volume_mm3":     { "type": "number", "description": "Label 4 only." },
            "necrosis_percentage":      { "type": "number", "minimum": 0, "maximum": 100,
                                          "description": "necrosis_vol / total_vol × 100." }
          }
        },

        "confidence_metrics": {
          "type": "object",
          "description": "Gating-fused mean Dice and per-class sigmoid confidence scores.",
          "properties": {
            "mean_dice_score": { "type": "number", "minimum": 0, "maximum": 1 },
            "per_class_confidence": {
              "type": "object",
              "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },

    "anatomical_mapping": {
      "type": "object",
      "description": "Built by TumorDescriptorGenerator._build_anatomical_mapping() from BrainAtlasMapper.process_segmentation() output. Registration via FSL FLIRT affine (registration.py).",
      "required": ["atlas_name", "affected_regions"],
      "properties": {
        "atlas_name": {
          "type": "string",
          "enum": ["harvard_oxford", "AAL3", "MNI152", "Julich"],
          "description": "Atlas used for region labelling. Default: harvard_oxford."
        },
        "registration_method": {
          "type": "string",
          "enum": ["affine", "ANTs_SyN", "SPM_DARTEL"],
          "description": "Registration algorithm applied (registration.py). Default: affine (FSL FLIRT, NCC cost)."
        },
        "affected_regions": {
          "type": "array",
          "description": "Overall ranked list of affected atlas regions across all tumor components.",
          "items": { "$ref": "#/definitions/affected_region" }
        },
        "subregion_mapping": {
          "type": "object",
          "description": "Per-component region lists, formatted by _format_subregion_mapping(). Source keys in atlas: enhancing_tumor_regions, necrotic_and_non_enhancing_tumor_core, peritumoral_edema.",
          "properties": {
            "enhancing_tumor":   { "type": "array", "items": { "$ref": "#/definitions/affected_region" } },
            "necrotic_core":     { "type": "array", "items": { "$ref": "#/definitions/affected_region" } },
            "peritumoral_edema": { "type": "array", "items": { "$ref": "#/definitions/affected_region" } }
          }
        },
        "hemisphere": {
          "type": "string",
          "enum": ["left", "right", "bilateral"],
          "description": "Dominant hemisphere from atlas_results['metadata']['hemisphere']."
        },
        "crossing_midline": {
          "type": "boolean",
          "description": "Whether tumor crosses corpus callosum (atlas_results['metadata']['crossing_midline'])."
        }
      }
    },

    "model_metadata": {
      "type": "object",
      "description": "Built by TumorDescriptorGenerator._build_model_metadata(). Populated at inference time.",
      "required": ["model_name", "model_version"],
      "properties": {
        "model_name":             { "type": "string",  "description": "e.g., 'MoME+'" },
        "model_version":          { "type": "string",  "description": "e.g., 'v1.0.0'" },
        "training_datasets":      { "type": "array",  "items": { "type": "string" }, "description": "e.g., ['BraTS2021', 'BraTS2024_GLI']" },
        "inference_timestamp":    { "type": "string",  "format": "date-time", "description": "datetime.utcnow().isoformat() + 'Z'" },
        "processing_time_seconds":{ "type": "number" }
      }
    },

    "clinical_features": {
      "type": "object",
      "description": "Optional. Built by TumorDescriptorGenerator._extract_clinical_features(). mass_effect inferred from total_tumor_volume_mm3 > 10000. eloquent_area_involvement detects 'Precentral' in top-5 regions.",
      "properties": {
        "mass_effect": {
          "type": "boolean",
          "description": "True when total_tumor_volume_mm3 > 10,000 (heuristic)."
        },
        "ventricular_involvement": { "type": "boolean" },
        "eloquent_area_involvement": {
          "type": "array",
          "items": { "type": "string", "enum": ["motor_cortex", "speech_area", "visual_cortex", "brainstem"] }
        },
        "estimated_grade": {
          "type": "string",
          "enum": ["low_grade", "high_grade", "unknown"],
          "description": "Imaging-based estimate only. Not diagnostic. Default: 'unknown'."
        }
      }
    }
  },

  "definitions": {
    "tumor_component": {
      "type": "object",
      "description": "Output of TumorDescriptorGenerator._analyze_component(seg_data, label, voxel_vol).",
      "required": ["present", "volume_mm3"],
      "properties": {
        "present":          { "type": "boolean", "description": "True if np.any(seg_data == label)." },
        "volume_mm3":       { "type": "number",  "minimum": 0, "description": "voxel_count × voxel_vol." },
        "voxel_count":      { "type": "integer", "minimum": 0 },
        "confidence_score": { "type": "number",  "minimum": 0, "maximum": 1,
                              "description": "Mean sigmoid activation over predicted mask voxels. Class-specific." },
        "centroid_coords":  {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3, "maxItems": 3,
          "description": "[x, y, z] mean of argwhere(mask) — voxel space by default; MNI after registration."
        }
      }
    },

    "affected_region": {
      "type": "object",
      "description": "Single atlas region overlap record. Produced by region_analysis.py and formatted by _format_subregion_mapping().",
      "required": ["region_id", "region_name", "percentage_involvement", "tumor_volume_in_region_mm3"],
      "properties": {
        "region_id":                  { "type": "integer", "description": "Harvard-Oxford atlas numeric region ID." },
        "region_name":                { "type": "string",  "description": "Anatomical label, e.g., 'Middle Frontal Gyrus'." },
        "percentage_involvement":     { "type": "number",  "minimum": 0, "maximum": 100,
                                        "description": "% of this atlas region voxels occupied by tumor. Computed in region_analysis.py." },
        "tumor_volume_in_region_mm3": { "type": "number",  "description": "Absolute tumor voxel volume inside this region." },
        "total_region_volume_mm3":    { "type": "number" },
        "hemisphere":                 { "type": "string",  "enum": ["left", "right"] }
      }
    }
  },

  "examples": [
    {
      "patient_info": {
        "case_id": "BraTS-GLI-00006-100",
        "scan_date": "2024-03-15"
      },
      "imaging_metadata": {
        "modalities": ["T1", "T1ce", "T2", "FLAIR"],
        "scanner_info": {
          "manufacturer": "Unknown",
          "field_strength": 3.0,
          "resolution_mm": [1.0, 1.0, 1.0]
        }
      },
      "segmentation_results": {
        "tumor_components": {
          "enhancing_tumor": {
            "present": true,
            "volume_mm3": 8500.0,
            "voxel_count": 8500,
            "confidence_score": 0.94,
            "centroid_coords": [78.2, 105.6, 88.4]
          },
          "necrotic_core": {
            "present": true,
            "volume_mm3": 29700.0,
            "voxel_count": 29700,
            "confidence_score": 0.88,
            "centroid_coords": [79.1, 104.8, 87.9]
          },
          "peritumoral_edema": {
            "present": true,
            "volume_mm3": 34200.0,
            "voxel_count": 34200,
            "confidence_score": 0.85,
            "centroid_coords": [80.5, 106.2, 89.1]
          }
        },
        "volumetric_analysis": {
          "total_tumor_volume_mm3": 72400.0,
          "whole_tumor_volume_mm3": 72400.0,
          "tumor_core_volume_mm3": 38200.0,
          "enhancing_volume_mm3": 8500.0,
          "necrosis_percentage": 41.0
        },
        "confidence_metrics": {
          "mean_dice_score": 0.88,
          "per_class_confidence": {
            "enhancing_tumor": 0.92,
            "necrotic_core": 0.88,
            "edema": 0.85
          }
        }
      },
      "anatomical_mapping": {
        "atlas_name": "harvard_oxford",
        "registration_method": "affine",
        "affected_regions": [
          { "region_id": 12, "region_name": "Middle Frontal Gyrus", "percentage_involvement": 42.3,
            "tumor_volume_in_region_mm3": 6200.0, "hemisphere": "right" },
          { "region_id": 7,  "region_name": "Precentral Gyrus",     "percentage_involvement": 14.6,
            "tumor_volume_in_region_mm3": 2800.0, "hemisphere": "right" }
        ],
        "subregion_mapping": {
          "enhancing_tumor": [
            { "region_id": 12, "region_name": "Middle Frontal Gyrus", "percentage_involvement": 42.3,
              "tumor_volume_in_region_mm3": 3600.0, "hemisphere": "right" }
          ],
          "necrotic_core": [
            { "region_id": 12, "region_name": "Middle Frontal Gyrus", "percentage_involvement": 38.1,
              "tumor_volume_in_region_mm3": 11300.0, "hemisphere": "right" }
          ],
          "peritumoral_edema": [
            { "region_id": 7, "region_name": "Precentral Gyrus", "percentage_involvement": 22.4,
              "tumor_volume_in_region_mm3": 7650.0, "hemisphere": "right" }
          ]
        },
        "hemisphere": "right",
        "crossing_midline": false
      },
      "model_metadata": {
        "model_name": "MoME+",
        "model_version": "v1.0.0",
        "training_datasets": ["BraTS2024_GLI"],
        "inference_timestamp": "2024-03-15T09:14:33Z",
        "processing_time_seconds": 15.2
      },
      "clinical_features": {
        "mass_effect": true,
        "ventricular_involvement": false,
        "eloquent_area_involvement": ["motor_cortex"],
        "estimated_grade": "unknown"
      }
    }
  ]
}
